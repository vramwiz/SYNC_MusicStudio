"""Prepare source-preserving stage-one PSDs, batch 2; never overwrite PSDs."""
import hashlib
import json
import shutil
from pathlib import Path
from PIL import Image

WORK=Path(__file__).resolve().parent
PREVIOUS=WORK.parent/'PSD_Conversion_20261009'
ROOT=Path(r'C:\Users\zan12\Documents\SYNC_MusicStudio\Characters\PNG\東北きりたん')
CATALOG=json.loads((ROOT/'分類目録.json').read_text(encoding='utf-8-sig'))
CORE=json.loads((ROOT/'00_ガイドと目録/01_演奏素材/manifest_core.json').read_text(encoding='utf-8-sig'))

def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()

def write_new(path,data):
    with path.open('x',encoding='utf-8') as f:
        json.dump(data,f,ensure_ascii=False,indent=2)

LABELS={
 'accordion':['基本_中開き','閉じ_中央鍵盤','閉じ_休符候補','閉じ寄り_下寄り鍵盤','開き_上寄り鍵盤'],
 'tambourine':['基本_打面接触','打つ直前','リム接触寄り','軽い角度変更_待機'],
 'violin':['基本','下げ弓','待機_弦から離す'],
 'acoustic_guitar':['基本','ダウンストローク','アップストローク','ミュート_待機','中フレット'],
 'marimba':['基本_黒窓群','左離脱_黒窓群','右離脱_透明窓群','両手待機_透明窓群','左低域接触_透明窓群'],
 'cello':['基本_接触','左寄り_接触','内寄り_接触_位置差注意'],
 'normal_marimba':['画面左低め_画面右上げ','画面左上げ_画面右低め','両側上げ_構え'],
}
ATTRIBUTES={'accordion':'鍵盤','tambourine':'打撃','violin':'弓奏','acoustic_guitar':'撥弦',
            'marimba':'打撃','cello':'弓奏','normal_marimba':'打撃'}
NORMAL_GUIDE=dict(
 limits_ja=['3姿勢の静止部には0〜1px程度の位置差と輪郭・色の描画差がある。',
            '低い側のマレットは音板上に見えるが、厳密な接触瞬間・音程・専門奏法は保証されていない。',
            '透明部のRGBに生成色が残り、端にalpha1の薄い画素が残る場合がある。実alphaを保持する。'],
 integrated_use_ja='BASE/Aは左右の構えを交替する候補、Bは両側を上げた構え。再生順・保持時間・打音は未指定。',
 separation_outlook_ja='頭以外は体・手・マレット・音板・架台・足の一体画像。個別分離には隠れた音板や接触部の補完が必要。',
 remaining_work_ja=['厳密な打撃接触と中間姿勢、静止部の統一、既存ボーカル頭部パーツとの対応。'],
 source_edition='通常配置改訂3姿勢・独立追補',
 status_ja='通常配置の独立試作。旧非標準配置5姿勢およびcore97姿勢と別管理。')

batch=[]
sources={}
for instrument,labels in LABELS.items():
    if instrument=='normal_marimba':
        group='normal_marimba'
        poses=[p for p in CATALOG['poses'] if p['group']==group]
        name='マリンバ_通常配置'
        folder=ROOT/'05_マリンバ_通常配置'
        guide=NORMAL_GUIDE
    else:
        group='core'
        inst=next(i for i in CATALOG['instruments'] if i['instrument']==instrument)
        poses=[p for p in CATALOG['poses'] if p['group']==group and p['instrument']==instrument]
        name=inst['name_ja']
        folder=ROOT/inst['folder']
        guide=next(i for i in CORE['instruments'] if i['instrument']==instrument)
    assert len(poses)==len(labels)
    final=folder/('東北きりたん_'+name+'.psd')
    if final.exists():
        raise FileExistsError(final)
    head=ROOT/poses[0]['head_file']
    assert all(p['head_file']==poses[0]['head_file'] for p in poses)
    with Image.open(head) as im:
        size=im.size
        assert im.mode=='RGBA'
    layers=[]
    def add_group(key,name,parent=''):
        layers.append(dict(key=key,name=name,parent=parent,visible=True))
    add_group('character','キャラクター')
    add_group('head_group','頭部','character')
    layers.append(dict(key='head',name='固定頭（付属PNG）',parent='head_group',visible=True,file=str(head)))
    add_group('poses','演奏姿勢','character')
    mapping=[]
    for n,(pose,label) in enumerate(zip(poses,labels)):
        source=ROOT/pose['body_file']
        with Image.open(source) as im:
            assert im.mode=='RGBA' and im.size==size
            pixel_hash=hashlib.sha256(im.tobytes()).hexdigest()
        layer_name='*基本' if n==0 else f'*演奏{n:02d}_{pose["pose_id"]}_{label}'
        key=f'pose_{n:02d}'
        layers.append(dict(key=key,name=layer_name,parent='poses',visible=n==0,file=str(source)))
        entry=dict(pose_id=pose['pose_id'],label_ja=label,source_label_ja=pose['label_ja'],key=key,
                   layer_name=layer_name,layer_path='キャラクター/演奏姿勢/'+layer_name,
                   source=str(source),source_sha256=digest(source),rgba_sha256=pixel_hash,
                   preview_file='プレビュー/'+pose['pose_id']+'.png')
        if pose.get('composite_file'):
            entry['supplied_composite']=str(ROOT/pose['composite_file'])
            sources[entry['supplied_composite']]=digest(Path(entry['supplied_composite']))
        mapping.append(entry)
        sources[str(source)]=entry['source_sha256']
    add_group('instrument_metadata','楽器名')
    add_group('attribute',ATTRIBUTES[instrument],'instrument_metadata')
    add_group('formal_name',name,'attribute')
    config=dict(width=size[0],height=size[1],output=str(WORK/instrument),layers=layers,
                states=[dict(key=p['key'],id=p['pose_id']) for p in mapping])
    config_path=WORK/(instrument+'-config.json')
    write_new(config_path,config)
    batch.append(dict(instrument=instrument,source_group=group,name_ja=name,attribute=ATTRIBUTES[instrument],
                      config=str(config_path),staging=str(WORK/instrument),destination=str(final),
                      record_directory=str(folder/'PSD変換記録'),canvas_wh=list(size),pose_count=len(poses),
                      head_source=str(head),head_sha256=digest(head),poses=mapping,guide=guide,
                      head_policy='supplied fixed head unchanged; vocal expression-layer migration pending',
                      instrument_metadata_is_not_separate_raster=True,
                      chair_and_equipment_integrated=instrument=='cello'))
    sources[str(head)]=digest(head)

vocal=Path(r'C:\Users\zan12\Documents\SYNC_MusicStudio\Characters\PSD\東北きりたん_立ち絵.psd')
sources[str(vocal)]=digest(vocal)
progress=ROOT/'PSD変換進捗.json'
prior=json.loads(progress.read_text(encoding='utf-8-sig'))
for existing in prior['batch_1']:
    path=Path(existing['psd'])
    assert digest(path)==existing['psd_sha256']
    sources[str(path)]=digest(path)
shutil.copyfile(progress,WORK/'progress-before.json')
write_new(WORK/'batch.json',batch)
write_new(WORK/'source-hashes-before.json',sources)
for source_name in ('VerifyAndSave.ps1','BuildInstrumentPsd.dpr'):
    destination=WORK/source_name
    if destination.exists(): raise FileExistsError(destination)
    shutil.copyfile(PREVIOUS/source_name,destination)
(WORK/'build').mkdir()
exe=PREVIOUS/'build/BuildInstrumentPsd.exe'
shutil.copyfile(exe,WORK/'build/BuildInstrumentPsd.exe')
write_new(WORK/'reused-tools.json',dict(executable=str(exe),sha256=digest(exe),
                                      source_sha256=digest(PREVIOUS/'BuildInstrumentPsd.dpr'),
                                      application=r'D:\DelphiProg\AIArtToPSD\Win64\Release\AIArtToPSD.exe'))
print('Prepared 6 core instruments / 25 poses + normal marimba / 3 poses. Existing PSDs protected.')
